# Copy to .env and fill in real values. NEVER commit the real .env.
DEFECTDOJO_URL=http://defectdojo-django-svc.voc-core.svc.cluster.local:8080
DEFECTDOJO_API_KEY=changeme
DEFECTDOJO_VERIFY_TLS=false

EPSS_API_URL=https://api.first.org/data/v1/epss

CVSS_WEIGHT=0.5
EPSS_WEIGHT=0.5
EPSS_HIGH_THRESHOLD=0.7

# In-process scheduler (set true for Deployment mode; leave false if a k8s CronJob triggers POST /score)
RUN_SCHEDULER=false
SCORING_INTERVAL_SECONDS=3600

LOG_LEVEL=INFO
