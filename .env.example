# Copy to .env and fill in real values. NEVER commit the real .env.

# --- DefectDojo ---
DD_API_KEY=changeme
DD_URL=http://localhost:8080
# Leave DD_ENGAGEMENT_ID empty to auto-create engagement via product/engagement name
DD_ENGAGEMENT_ID=
DD_PRODUCT_NAME=Lab Targets
DD_ENGAGEMENT_NAME=Continuous Scanning

# --- k3d cluster ---
K3D_CLUSTER_NAME=voc
K3D_API_PORT=6550

# --- Docker network for scan-all.sh targets ---
DOCKER_NETWORK=voc-scan

# --- Scanner targets (space-separated host:port) ---
TARGETS="juice-shop:3000 dvwa:80"

# --- Grype target image ---
GRYPE_IMAGE=alpine:latest

# --- Cleanup target containers after scan ---
CLEANUP_TARGETS=true

# --- n8n workflow env vars (set when wiring the n8n workflow) ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE
THEHIVE_URL=http://thehive-svc.voc-core.svc.cluster.local:9000
