{
  "name": "DefectDojo Priority Routing",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 5 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        -400,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://defectdojo-django.voc-core.svc.cluster.local/api/v2/findings/",
        "authentication": "none",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "active",
              "value": "true"
            },
            {
              "name": "limit",
              "value": "200"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Token b2b0ad8a3176b64213ca700d4b56c3b656f6b51c"
            }
          ]
        },
        "options": {}
      },
      "id": "dd-findings",
      "name": "Get DefectDojo Findings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -200,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const body = item.json;\n  for (const f of (body.results || [])) {\n    const tags = (f.tags || []).map(t => String(t));\n    const pTag = tags.find(t => t.startsWith('priority-'));\n    const priority = pTag ? parseInt(pTag.split('-')[1], 10) : null;\n    out.push({ json: { id: f.id, title: f.title, severity: f.severity, cve: f.cve, priority, tags } });\n  }\n}\nreturn out;"
      },
      "id": "flatten",
      "name": "Flatten findings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "priority-high",
              "leftValue": "={{ $json.priority }}",
              "rightValue": 60,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-high",
      "name": "Priority >= 60?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/services/REPLACE_ME",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"text\": \"[VOC] Finding #{{ $json.id }} ({{ $json.severity }}) priority={{ $json.priority }}: {{ $json.title }}\" }",
        "options": {}
      },
      "id": "slack-high",
      "name": "Alert: High/Critical",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        -120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://thehive-svc.voc-core.svc.cluster.local:9000/api/v1/case",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "Bearer REPLACE_WITH_THEHIVE_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"title\": \"[VOC] \" + $json.title, \"description\": \"DefectDojo finding #\" + $json.id + \" (CVE: \" + ($json.cve || \"n/a\") + \", severity: \" + $json.severity + \", priority: \" + $json.priority + \")\", \"severity\": 2, \"tags\": [\"voc\", \"auto\"] }",
        "options": {}
      },
      "id": "thehive-case",
      "name": "Create TheHive case",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        60
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/services/REPLACE_ME",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"text\": \"[VOC] Medium finding #{{ $json.id }} priority={{ $json.priority }}: {{ $json.title }}\" }",
        "options": {}
      },
      "id": "slack-med",
      "name": "Alert: Medium",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        220
      ]
    }
  ],
  "connections": {
    "Every 5 min": {
      "main": [
        [
          {
            "node": "Get DefectDojo Findings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get DefectDojo Findings": {
      "main": [
        [
          {
            "node": "Flatten findings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Flatten findings": {
      "main": [
        [
          {
            "node": "Priority >= 60?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Priority >= 60?": {
      "main": [
        [
          {
            "node": "Alert: High/Critical",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Alert: Medium",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Alert: High/Critical": {
      "main": [
        [
          {
            "node": "Create TheHive case",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "voc"
    }
  ]
}