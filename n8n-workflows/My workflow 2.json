        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"apiVersion\": \"batch/v1\", \"kind\": \"Job\", \"metadata\": {\"generateName\": \"scan-orchestrator-\", \"namespace\": \"scanning\", \"labels\": {\"app\": \"voc-orchestrator\", \"voc.project/triggered-by\": \"n8n\"}}, \"spec\": {\"ttlSecondsAfterFinished\": 600, \"backoffLimit\": 1, \"template\": {\"spec\": {\"serviceAccountName\": \"scan-orchestrator\", \"restartPolicy\": \"Never\", \"containers\": [{\"name\": \"orchestrator\", \"image\": \"voc-orchestrator:latest\", \"imagePullPolicy\": \"Never\"}]}}}}",
        "options": {
          "allowUnauthorizedCerts": true
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        128,
        -272
      ],
      "id": "0ea5483e-b7a0-445c-8998-5238e0c0eaa5",
      "name": "Create Scan Job"
    },
    {
      "parameters": {
        "jsCode": "const jobName = $input.first().json?.metadata?.name || \"unknown\";\nconst namespace = \"scanning\";\nconst startedAt = new Date().toISOString();\nreturn [{ json: { jobName, namespace, startedAt, status: \"Running\", pollCount: 0, maxPolls: 120 } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        -32
      ],
      "id": "a18bfc5b-b2b5-49fa-904e-af19762d04f9",
