      "id": "get-dd-findings-node",
      "name": "Get DefectDojo Findings"
    },
    {
      "parameters": {
        "jsCode": "const findings = $input.first().json?.results || [];\nconst jobData = $(\"Check Job Status\").first()?.json || {};\nconst byPriority = { critical: 0, high: 0, medium: 0, low: 0, unscored: 0 };\nconst bySeverity = { Critical: 0, High: 0, Medium: 0, Low: 0, Info: 0 };\nconst topFindings = [];\nfor (const f of findings) {\n  const sev = f.severity || \"Info\";\n  bySeverity[sev] = (bySeverity[sev] || 0) + 1;\n  const tags = (f.tags || []).map(t => String(t));\n  const pTag = tags.find(t => t.startsWith(\"priority-\"));\n  if (pTag) {\n    const score = parseInt(pTag.split(\"-\")[1], 10);\n    if (score >= 80) { byPriority.critical++; topFindings.push({ severity: f.severity, title: f.title, score }); }\n    else if (score >= 60) { byPriority.high++; topFindings.push({ severity: f.severity, title: f.title, score }); }\n    else if (score >= 40) { byPriority.medium++; }\n    else { byPriority.low++; }\n  } else { byPriority.unscored++; }\n}\ntopFindings.sort((a, b) => b.score - a.score);\nconst sampleLines = topFindings.slice(0, 5).map(f => `[${f.severity}] ${f.title} (score: ${f.score})`).join(\"\\n\");\nconst body = `The automated security pipeline has finished scanning your cluster targets and run the prioritization scoring model.\\n\\nTotal Active Findings in DefectDojo: ${findings.length}\\n\\nPriority Alert Breakdown:\\n  Critical Action (Score >= 80): ${byPriority.critical}\\n  High Priority  (Score 60-79):  ${byPriority.high}\\n  Medium Priority (Score 40-59): ${byPriority.medium}\\n  Low Priority   (Score < 40):   ${byPriority.low}\\n  Unscored (no CVE/CVSS data):   ${byPriority.unscored}\\n\\nSeverity Breakdown:\\n  Critical: ${bySeverity.Critical}\\n  High:     ${bySeverity.High}\\n  Medium:   ${bySeverity.Medium}\\n  Low:      ${bySeverity.Low}\\n  Info:     ${bySeverity.Info}\\n\\nHigh-Priority Vulnerabilities Sample:\\n${sampleLines || \"None\"}\\n\\nScan started:     ${jobData.startedAt || \"N/A\"}\\nReport generated: ${new Date().toISOString()}`;\nreturn [{ json: { body, total: findings.length, byPriority, bySeverity } }];\n"
      },
