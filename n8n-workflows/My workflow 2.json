            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.K8S_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"apiVersion\": \"batch/v1\",\n  \"kind\": \"Job\",\n  \"metadata\": {\n    \"generateName\": \"scan-orchestrator-\",\n    \"namespace\": \"scanning\",\n    \"labels\": {\n      \"app\": \"voc-orchestrator\",\n      \"voc.project/triggered-by\": \"n8n\"\n    }\n  },\n  \"spec\": {\n    \"ttlSecondsAfterFinished\": 600,\n    \"backoffLimit\": 1,\n    \"template\": {\n      \"spec\": {\n        \"serviceAccountName\": \"scan-orchestrator\",\n        \"restartPolicy\": \"Never\",\n        \"containers\": [\n          {\n            \"name\": \"orchestrator\",\n            \"image\": \"voc:latest\",\n            \"imagePullPolicy\": \"Never\",\n            \"command\": [\"/workspace/scripts/scan-all.sh\"]\n          }\n        ]\n      }\n    }\n  }\n}\n",
        "options": {
          "allowUnauthorizedCerts": true
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        176,
        -272
      ],
      "id": "0ea5483e-b7a0-445c-8998-5238e0c0eaa5",
      "name": "Create Scan Job"
    },
    {
      "parameters": {
        "jsCode": "const jobName = $input.first().json?.metadata?.name || 'unknown';\nconst namespace = 'scanning';\nconst startedAt = new Date().toISOString();\n\nreturn [{\n  json: {\n    jobName,\n    namespace,\n    startedAt,\n    status: 'Running',\n    pollCount: 0,\n    maxPolls: 120 // 120 polls * 15s = 30 minutes max wait\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        -32
      ],
      "id": "a18bfc5b-b2b5-49fa-904e-af19762d04f9",
      "name": "Extract Job Name"
    },
    {
      "parameters": {
        "url": "=https://kubernetes.default.svc/apis/batch/v1/namespaces/scanning/jobs/{{ $json.jobName }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.K8S_TOKEN }}"
            }
          ]
        },
        "options": {
          "allowUnauthorizedCerts": true
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -256,
        -32
      ],
      "id": "88f952b0-48da-4be0-88c7-cdd59b599ec0",
      "name": "Poll Job Status"
    },
    {
      "parameters": {
        "jsCode": "const job = $input.first().json;\nconst conditions = job?.status?.conditions || [];\n// Retrieve previous pollCount and job info from either the first setup or the loop wait node\nconst prevData = $('Extract Job Name').first()?.json || $('Wait 15s').first()?.json || {};\n\nlet status = 'Running';\nlet done = false;\n\nfor (const c of conditions) {\n  if (c.type === 'Complete' && c.status === 'True') {\n    status = 'Complete';\n    done = true;\n    break;\n  }\n  if (c.type === 'Failed' && c.status === 'True') {\n    status = 'Failed';\n    done = true;\n    break;\n  }\n}\n\nconst pollCount = (prevData.pollCount || 0) + 1;\nif (pollCount >= (prevData.maxPolls || 120)) {\n  status = 'Timeout';\n  done = true;\n}\n\nreturn [{\n  json: {\n    jobName: prevData.jobName || job?.metadata?.name,\n    namespace: prevData.namespace || 'scanning',\n    status,\n    done,\n    pollCount,\n    maxPolls: prevData.maxPolls || 120\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -64,
        -32
      ],
