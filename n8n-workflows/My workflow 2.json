      ],
      "id": "88f952b0-48da-4be0-88c7-cdd59b599ec0",
      "name": "Poll Job Status"
    },
    {
      "parameters": {
        "jsCode": "const job = $input.first().json;\nconst conditions = job?.status?.conditions || [];\n// FIX: was referencing nonexistent node \"Wait 15s\" - correct name is \"Wait\"\nconst prevData = $(\"Extract Job Name\").first()?.json || $(\"Wait\").first()?.json || {};\nlet status = \"Running\";\nlet done = false;\nfor (const c of conditions) {\n  if (c.type === \"Complete\" && c.status === \"True\") { status = \"Complete\"; done = true; break; }\n  if (c.type === \"Failed\" && c.status === \"True\") { status = \"Failed\"; done = true; break; }\n}\nconst pollCount = (prevData.pollCount || 0) + 1;\nif (pollCount >= (prevData.maxPolls || 120)) { status = \"Timeout\"; done = true; }\nreturn [{ json: { jobName: prevData.jobName || job?.metadata?.name, namespace: prevData.namespace || \"scanning\", startedAt: prevData.startedAt, status, done, pollCount, maxPolls: prevData.maxPolls || 120 } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -64,
        -32
      ],
      "id": "7819c10e-c890-4810-9ad5-fcd3c214c9db",
      "name": "Check Job Status"
    },
