{
  "annotations": { "list": [] },
  "description": "VOC System Health — Pod Availability, Startup Timeline, Restart Breakdown, and Pod Statuses.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "datasource": "${DS_PROM}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "count(kube_pod_info{namespace=\"voc-core\"})", "legendFormat": "Core Pods", "refId": "A" }],
      "title": "voc-core Active Pods",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROM}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "count(kube_pod_info{namespace=\"targets\"})", "legendFormat": "Target Pods", "refId": "A" }],
      "title": "targets Active Pods",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROM}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "count(kube_pod_info{namespace=\"monitoring\"})", "legendFormat": "Monitoring Pods", "refId": "A" }],
      "title": "monitoring Active Pods",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROM}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "sum(kube_pod_container_status_restarts_total)", "legendFormat": "Restarts", "refId": "A" }],
      "title": "Total Pod Restarts",
      "type": "stat"
    },

    {
      "datasource": "${DS_PROM}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Created Time" },
            "properties": [
              { "id": "custom.width", "value": 260 }
            ]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "id": 5,
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Created Time", "desc": true }]
      },
      "targets": [
        {
          "expr": "kube_pod_created * 1000",
          "format": "table",
          "instant": true,
          "legendFormat": "{{namespace}}/{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Pod Startup Timeline & Age (Created Timestamp)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": {},
            "renameByName": {
              "pod": "Pod Name",
              "namespace": "Namespace",
              "Value": "Created Time"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              { "dateFormat": "YYYY-MM-DD HH:mm:ss", "targetField": "Created Time", "destinationType": "time" }
            ]
          }
        }
      ],
      "type": "table"
    },

    {
      "datasource": "${DS_PROM}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Restarts",
            "drawStyle": "bars",
            "fillOpacity": 80
          }
        }
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(kube_pod_container_status_restarts_total) by (pod)",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Pod Restart Breakdown (Which pod restarted)",
      "type": "timeseries"
    },

    {
      "datasource": "${DS_PROM}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 25, "stacking": { "mode": "normal" } }
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "id": 7,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [{ "expr": "sum(kube_pod_status_phase) by (phase, namespace)", "legendFormat": "{{namespace}} ({{phase}})", "refId": "A" }],
      "title": "Pod Status Phases Across Cluster",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["voc", "health", "system"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "name": "DS_PROM",
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
  "title": "VOC System Health",
  "uid": "voc-system-health",
  "version": 3
}
