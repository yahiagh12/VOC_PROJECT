# ---- Kubernetes / cluster ----
kubeconfig
*.kubeconfig
**/kubeconfig
k3s.yaml
*.k3s.yaml
# local working copies of values with secrets
**/values-local.yaml
**/values.local.yaml
**/secrets.yaml
**/secret.yaml
**/*-secret.yaml
**/*-secrets.yaml
# keep examples/templates
!**/values-example.yaml
!**/values.example.yaml
!**/secrets.example.yaml
!**/secret.example.yaml

# ---- Credentials & keys (NEVER commit) ----
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.token
*.tokenfile
credentials
.env.prod
.env.production
.env.staging
.env.local
.env.*.local

# ---- .env files (keep .env.example) ----
.env
*.env
!*.env.example
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
.tox/

# ---- Node / n8n ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
n8n-local/

# ---- Docker ----
*.pid
docker-compose.override.yml

# ---- OS ----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- IDE / editors ----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ---- VOC runtime artifacts ----
# kubeconfig written by k3d (contains cluster credentials)
.kube/
# generated scan reports + scanner working dirs
scanners/reports/
scanners/zap/
scanners/nuclei-templates/
# dynamically generated ZAP plan (keep config/zap-plan.yaml checked in)
config/zap-plan-auto.yaml
# toolbox image build cache (start.ps1 optimization)
.toolbox-build-hash

# ---- Misc ----
*.log
logs/
tmp/
temp/
*.bak
*.tmp
*.orig
